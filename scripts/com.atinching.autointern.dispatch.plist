<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.atinching.autointern.dispatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__DISPATCH_SCRIPT__</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/autointern-dispatch.launchd.out</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/autointern-dispatch.launchd.err</string>
</dict>
</plist>
